# Base URL of dettavo-server, including its base path (/api/v1). No trailing slash.
VITE_API_BASE_URL=http://localhost:2060/api/v1

# Development only: true lets `npm run dev` run the whole app in a browser tab, without installing it.
# A build ignores it and always asks for the installed app.
VITE_SKIP_INSTALL_GUARD=false
